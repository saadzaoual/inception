# Template for srcs/.env — copy it before the first run:
#     cp srcs/.env.example srcs/.env
#
# This file holds configuration only. Passwords are NOT kept here: each one
# lives in its own file under secrets/ and is mounted as a Docker secret.

# Database
MYSQL_DATABASE=wordpress
MYSQL_USER=szaoual

# Domain served by nginx; must resolve to 127.0.0.1 in /etc/hosts
DOMAIN_NAME=szaoual.42.fr

# WordPress administrator (the username must not contain "admin")
WP_ADMIN_USER=supervisor
WP_ADMIN_EMAIL=supervisor@szaoual.42.fr

# Second, non-administrator WordPress account
WP_NORMAL_USER=writer
WP_NORMAL_EMAIL=writer@szaoual.42.fr
